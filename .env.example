# CTFY platform / authoring round
CTFY_PLATFORM_URL=https://ctfy.tsinghua.edu.cn
CTFY_TOKEN=
AUTHORING_COMPETITION_ID=
AUTHORING_TOPIC=
AUTHORING_DEADLINE_MINUTES=540
AUTHORING_WORK_DIR=work

# The platform normally injects these LLM_* values for a hosted run.
LLM_FLAVOR=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# auto prefers Claude Code CLI when available, then falls back to direct HTTP.
# Values: auto | claude_cli | direct
AUTHORING_MODEL_BACKEND=auto
CLAUDE_BIN=claude
CLAUDE_CODE_TIMEOUT=300

# Optional during local development only.
AUTHORING_LOCAL_SMOKE=0
AUTHORING_VERBOSE=0
AUTHORING_CALIBRATION=1
AUTHORING_CALIBRATION_TRIALS=5
AUTHORING_CALIBRATION_TURNS=16
# Optional platform-provided calibration target and expected answers JSON.
AUTHORING_CALIBRATION_TARGET=
AUTHORING_CALIBRATION_ANSWERS=
